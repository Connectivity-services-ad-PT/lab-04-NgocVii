{
  "info": {
    "name": "FIT4110 Lab 04 - IoT Ingestion Docker Test",
    "description": "Postman collection for testing IoT Ingestion service in Docker container",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "01_Functional",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has correct service name\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"service\", \"iot-ingestion\");",
                  "});",
                  "",
                  "pm.test(\"Response has status ok\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"status\", \"ok\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create valid temperature reading",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 31.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-06-03T08:30:00+07:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/readings",
              "host": ["{{baseUrl}}"],
              "path": ["readings"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has reading_id\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"reading_id\");",
                  "});",
                  "",
                  "pm.test(\"Response has accepted true\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.accepted).to.equal(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get latest readings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/readings/latest?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["readings", "latest"],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has items array\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"items\");",
                  "  pm.expect(json.items).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
